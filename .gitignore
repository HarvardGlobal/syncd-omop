# Local logs (contain machine paths)
*.log
omop_viz/achilles_logs/
omop_viz/ares_app/site/data/**/log_*.txt
output/*/metadata/

# Docker toolbox credentials, loaded by compose.yml (env_file: .env). See README-docker.md.
# .env.* catches variants like .env.local or .env.prod; the template stays tracked.
.env
.env.*
!.env.example

.DS_Store
__pycache__/
*.pyc
.Rhistory

# omop_tools: third-party code, binaries and R libraries are fetched by the setup steps in
# omop_tools/README.md; large or machine-specific outputs are regenerated by the scripts.
omop_tools/PatientExploreR/
omop_tools/comorbidity4j/
omop_tools/comorbidity4j_bin/
omop_tools/r_lib_cohortcontrast/
omop_tools/comorbidity4j_input/
omop_tools/comorbidity4j_results/
omop_tools/cohortcontrast_results/
