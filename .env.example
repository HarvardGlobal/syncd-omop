# =============================================================================
# SYNCD: environment template
# =============================================================================
#
# Copy this file to `.env` at the repo root, fill in real values, then lock it down:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` is git-ignored and must never be committed. This template is tracked
# and must only ever hold placeholders.
#
# `.env` is the single source of truth for every machine- or person-specific
# setting. No script hardcodes a database name, user, or install path.
#
# Read by:
#   - scripts/lib/env.R  (all R scripts)    -> DatabaseConnector
#   - scripts/lib/env.sh (all bash scripts) -> psql, via libpq's PG* variables
#   - compose.yml (`env_file: .env`)        -> passes everything into the `r` container
#
# A variable that is already set in your shell or by docker compose wins over this
# file, so a one-off run can override it, e.g.
#   OMOP_DB_NAME=synthetic_concurrent Rscript scripts/07_run_ares.R
#
# @see README-docker.md
# @see https://www.postgresql.org/docs/16/libpq-envars.html
# =============================================================================

# -----------------------------------------------------------------------------
# OMOP database (required)
# -----------------------------------------------------------------------------
# Several datasets can live on the same Postgres server; OMOP_DB_NAME picks one.
#   syncd_omop            -> this repo's load
#   synthetic_concurrent  -> the separate dockerised synthetic-omop project
OMOP_DB_HOST=localhost
OMOP_DB_PORT=5432
OMOP_DB_NAME=syncd_omop
OMOP_DB_USER=postgres
OMOP_DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Full path to psql, only if it isn't on your PATH.
# PSQL_BIN=/usr/bin/psql

# Port for the local ARES viewer (scripts/08_view_ares.sh).
# ARES_PORT=8085

# psql normally takes its PG* settings from the OMOP_DB_* values above. Set any
# of these only to deliberately point psql somewhere different.
# PGHOST=
# PGDATABASE=

# compose.yml runs the container as ${UID}:${GID} (default 1000:1000) so files written
# to the /work mount belong to you. Uncomment only if `id -u` / `id -g` aren't 1000.
# UID=1000
# GID=1000
